-- Interface file helpers

import Fun;
import List;
import Lexer;
import Ostap;
import Collection;
import Ref;
import Infix;

-- Registers the infix operators declared in unit's interface file (and,
-- recursively, in the interfaces it imports) into the context's infix table.
-- Infix entries may be anchored at operators coming from the imported units,
-- so imports are processed first; the context remembers which units were
-- already processed so each unit's infixes are registered at most once.
fun registerImportedInfixes (paths, unit, c) {
  fun infixRegContext (c) {
    [fun (d) {
       case d of
         Extern (_, _, Import (_, coUnit)) -> infixRegContext (registerImportedInfixes (paths, coUnit, c))
       | _                                 -> infixRegContext (c)
       esac
     },
     fun (ass, op, pos) {infixRegContext (onInfix (c, ass, op, pos))},
     fun (_, _) {infixRegContext (c)},
     fun () {c}
    ]
  }

  fun rec (c, ps) {
    case ps of
      {}          -> c
    | path : rest ->
        case sprintf ("%s/%s.i", path, unit) of
          fname ->
            if fexists (fname)
            then case parseString (syntax (intface -end), fread (fname)) of
                   Succ (make)           -> make (unit, path, false, infixRegContext (c)) [3] ()
                 | Fail (err, line, col) -> failure ("interface file: %s at %d:%d\n", err.hd, line, col)
                 esac
            else rec (c, rest)
            fi
        esac
    esac
  }

  if c.isProcessed (unit)
  then c
  else rec (c.markProcessed (unit), paths)
  fi
}

public fun loadInterface (paths, unit, explicity, callBacks) {
  -- Infixes (including those of transitively imported units) are registered
  -- by registerImportedInfixes above, so the main pass loads declarations
  -- with infix registration suppressed.
  fun noInfixContext (c) {
    [fun (d)       {noInfixContext (addDecl (c, d))},
     fun (_, _, _) {noInfixContext (c)},
     fun (p, i)    {noInfixContext (addImport (c, p, i))},
     fun ()        {c}
    ]
  }

  -- NB: this used `fix` over a two-argument function, but `fix` only supports
  -- single-argument recursion (it applies f(rec) to one arg), so the recursive
  -- step read a non-existent second argument and crashed. Hence imports only
  -- worked under -noimports. A named local recursive function works directly.
  fun rec (cb, ps) {
    case ps of
      {}           -> failure ("no interface file found for unit ""%s""\n", unit)
    | path : rest ->
        case sprintf ("%s/%s.i", path, unit) of
          fname ->
             if fexists (fname)
             then case parseString (syntax (intface -end), fread (fname)) of
                    Succ (make)             -> make (unit, path, explicity, noInfixContext (cb)) [3] ()
                  | x@Fail (err, line, col) -> failure ("interface file: %s at %d:%d\n", err.hd, line, col)
                  esac
             else rec (cb, rest)
             fi
        esac
    esac
  }

  rec (registerImportedInfixes (paths, unit, callBacks), paths)
}

public fun toInterface (p) {
  case p of
    Var (_, name)                           -> sprintf ("V,%s;\n", name)
  | Val (_, name)                           -> sprintf ("C,%s;\n", name)
  | Fun (_, Infix (fn, inf, [ass, pos]), n) -> case case pos of
                                                      At     (x) -> ["T", x]
                                                    | Before (x) -> ["B", x]
                                                    | After  (x) -> ["A", x]
                                                    esac of
                                                 [p, op] ->
                                                    sprintf ("F,%s,2;\n%s,""%s"",%s,""%s"";\n",
                                                             fn,
                                                             case ass of Left -> "L" | Right -> "R" | Nona -> "N" esac,
                                                             inf,
                                                             p,
                                                             op)
                                               esac
  | Fun (_, name@#str, n)                   -> sprintf ("F,%s,%d;\n", name, n)
  esac
}

public fun createContext (initInfixTable, onInfix) {
  makeContext ({}, emptySet (compare), initInfixTable, onInfix, emptySet (compare))
}

fun makeContext (decls, imports, infixTable, onInfix_, processed) {
  fun addDecl (d) {
    makeContext (d : decls, imports, infixTable, onInfix_, processed)
  }

  fun addImport (path, i) {
    makeContext (decls, addSet (imports, [path, i]), infixTable, onInfix_, processed)
  }
  
  fun getDecls () {
    decls
  }

  fun getImports () {
    imports.elements
  }
  
  fun onInfix (ass, op, pos) {
    makeContext (decls, imports, onInfix_ (infixTable, ass, op, pos), onInfix_, processed)
  }

  fun getDependentUnits (paths) {
    var tree      = ref (emptyMap (compare)),
        unitPaths = ref (emptyMap (compare));

    fun getUnits () {
      fun rec (acc, unit) {
        case case findMap (deref (tree), unit) of
               None           -> acc
             | Some (coUnits) -> foldl (rec, acc, coUnits.elements)
             esac of
          a@[acc, set] -> if compare (unit, "Std") == 0 !! memSet (set, unit)
                          then a
                          else [[unit, case findMap (deref (unitPaths), unit) of Some (p) -> p esac] : acc, addSet (set, unit)]
                          fi
       esac
      }
      
      reverse $ foldl (fun (acc, [path, i]) {rec (acc, i)}, [{}, emptySet (compare)], imports.elements)[0]
    }
    
    fun addEdge (unit, path, coUnit) {
      unitPaths ::= addMap (deref (unitPaths), unit, path);
      case deref (tree) of
        deTree -> tree ::= addMap (deTree,
                                   unit,
                                   addSet (case findMap (deTree, unit) of
                                             Some (s) -> s
                                           | _        -> emptySet (compare) 
                                           esac, coUnit))
      esac
    }
    
    fun localContext (acc) {
      [fun (Extern (unit, _, decl)) {
         case decl of
           Import (path, coUnit) -> case findMap (deref (tree), coUnit) of
                                      Some (_) -> localContext (acc)
                                    | None     -> addEdge (unit, path, coUnit);
                                                  localContext (addSet (acc, coUnit))
                                    esac
         | _ -> localContext (acc)
         esac
       },
       fun (_, _, _) {
         localContext (acc)
       },
       fun (_, _) {
         localContext (acc)
       },
       fun () {
         acc
       },
       0, 0, 0,
       -- isProcessed/markProcessed: the dependent-units traversal ignores
       -- infixes, so pretend every unit is already processed
       fun (_) {true},
       fun (_) {localContext (acc)}
      ]
    }

    fun getAcc (c) {
      c [3] ()
    }
    
    fun importContext (acc, unit) {
      loadInterface (paths, unit, true, localContext (acc)).getAcc
    }

    fun iterate (units) {
      fun rec (acc, units) {
         case units of
           {}           -> acc.elements
         | unit : units -> rec (importContext (acc, unit), units)
         esac
      }

      case units of
        {} -> skip
      | _  -> iterate (rec (emptySet (compare), units))
      esac
    }
    
    case foldl (fun (coUnits, [path, coUnit]) {
                  unitPaths ::= addMap (deref (unitPaths), coUnit, path);
                  addSet (coUnits, coUnit)
                },
                emptySet (compare),
                imports.elements).elements of
      workingList -> iterate (workingList)
    esac;

    getUnits ()
  }

  [addDecl, onInfix, addImport, getDecls, getImports, getDependentUnits, fun () {infixTable},
   fun (unit) {memSet (processed, unit)},
   fun (unit) {makeContext (decls, imports, infixTable, onInfix_, addSet (processed, unit))}]
}

fun addDecl (c, d) {
  c [0] (d)
}

fun onInfix (c, ass, op, pos) {
  c [1] (ass, op, pos)
}

fun isProcessed (c, unit) {
  c [7] (unit)
}

fun markProcessed (c, unit) {
  c [8] (unit)
}

fun addImport (c, p, i) {
  c [2] (p, i)
}

public fun getDecls (c) {
  c [3] ()
}

public fun getImports (c) {
  c [4] ()
}

public fun getDependentUnits (c, p) {
  c [5] (p)
}

public fun getInfixTable (c) {
  c [6] ()
}

var funspec = memo $ eta syntax (s["F"] token[","] i=lident a=(-token[","] (k=decimal {stringInt (k)} | token["*"] {Any}))? token[";"] {fun (unit, path, explicity, c) {c.addDecl (Extern (unit, explicity, Fun (i, case a of Some (n) -> n | None -> Any esac)))}}),
    varspec = memo $ eta syntax (s["V"] token[","] i=lident token[";"]                                   {fun (unit, path, explicity, c) {c.addDecl (Extern (unit, explicity, Var (i)))}}),
    valspec = memo $ eta syntax (s["C"] token[","] i=lident token[";"]                                   {fun (unit, path, explicity, c) {c.addDecl (Extern (unit, explicity, Val (i)))}}),
    impspec = memo $ eta syntax (s["I"] token[","] i=uident token[";"]                                   {fun (unit, path, explicity, c) {c.addDecl (Extern (unit, explicity, Import (path, i)))}}),
    infspec = memo $ eta syntax (a=ass  token[","] op=strlit token[","] p=anchor token[";"]              {fun (unit, path, explicity, c) {c.onInfix (a, op, p)}}),
    
    ass     = memo $ eta syntax (  s["L"] {Left}
                                 | s["R"] {Right}
                                 | s["N"] {Nona}
                                ),
    
    anchor  = memo $ eta syntax (m=mode token[","] op=strlit {m $ op}),
    
    mode    = memo $ eta syntax (  token["T"] {fun (x) {At (x)}} 
                                 | token["A"] {fun (x) {After (x)}}
                                 | token["B"] {fun (x) {Before (x)}}
                                ),
                                
    intface = memo $ eta syntax (spec=(funspec | varspec | valspec | impspec | infspec)* -end {
       fun (unit, path, explicity, c) {
         foldl (fun (c, x) {x (unit, path, explicity, c)},
                c.addImport (path, unit),
                spec)
       }
    });