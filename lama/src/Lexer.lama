-- Lexical analysis using Matcher

import Matcher;
import Ostap;
import Fun;
import Collection;
import List;

-- A hashtable to keep a source code location information.
-- The keys in this table are some (boxed) values, and values are
-- pairs [line, column]
var srcTab = emptyHashTab (1024, hash, flatCompare);

-- Adds a location info for given iten
public fun addLoc (x, loc) {
  srcTab := addHashTab (srcTab, x, loc)
}

-- A custom combinator to additionally add location info
public fun located (p) {
  syntax(l=pos x=p {addLoc (x, l); x})
}

-- Attaches location info for x to y
public fun reLoc (x, y) {
  srcTab := addHashTab (srcTab, y, getLoc (getRepr $ x))
}

-- Gets a representation for a name
public fun getRepr (name) {
  case name of
    Infix (_, inf, _) -> inf
  | Infix (_, inf)    -> inf
  | Qname (_, qn    ) -> qn
  | _                 -> name
  esac
}

-- Gets an inner name for a name
public fun getInner (name) {
  case name of
    Infix (fn, _, _) -> fn
  | Infix (fn, _)    -> fn
  | Qname (qn, _)    -> qn
  | _                -> name
  esac
}

-- Retrieves location info; fail if no info found
public fun getLoc (s) {
  case findHashTab (srcTab, s) of Some (loc) -> loc | None -> failure ("no location found for item %s\n", s.string) esac
}

-- A set of all keywords
var keywords =
   foldl (addSet,
          emptySet (compare),
          {"skip",
           "if",
           "then",
           "else",
           "elif",
           "fi",
           "while",
           "do",
           "od",
           "for",
           "var",
           "val",
           "fun",
           "case",
           "of",
           "esac",
           "true",
           "false",
           "str",
           "sexp",
           "array",
           "box",
           "at",
           "after",
           "before",
           "infix",
           "infixl",
           "infixr",
           "lazy",
           "eta",
           "let",
           "in",
           "public",
           "import",
           "syntax"});

-- Regular expression definitions.
public rWhiteSpace  = createRegexp ("([ \n\t]|--[^\n]*|\(\*([^*]|\*[^)])*\*\))*", "whitespace"),
       rComment     = createRegexp ("\(\*([^*]|\*[^)])*\*\)", "comment"),
       rSkip        = createRegexp ("skip\b", "skip"),
       rDecimal     = createRegexp ("-?[0-9]+", "decimal constant"),
       rStrlit      = createRegexp ("""([^""]|"""")*""", "string constant"),
       rChar        = createRegexp ("'([^']|''|\\[nt])'", "character constant"),
       rLident      = createRegexp ("[a-z][a-z_A-Z0-9']*", "lowercase identifier"),
       rUident      = createRegexp ("[A-Z][a-z_A-Z0-9']*", "uppercase identifier"),
       rIf          = createRegexp ("if\b", """if"""),
       rThen        = createRegexp ("then\b", """then"""),
       rElse        = createRegexp ("else\b", """else"""),
       rElif        = createRegexp ("elif\b", """elif"""),
       rFi          = createRegexp ("fi\b", """fi"""),
       rWhile       = createRegexp ("while\b", """while"""),
       rDo          = createRegexp ("do\b", """do"""),
       rOd          = createRegexp ("od\b", """od"""),
       rFor         = createRegexp ("for\b", """for"""),
       rVar         = createRegexp ("var\b", """var"""),
       rVal         = createRegexp ("val\b", """val"""),
       rFun         = createRegexp ("fun\b", """fun"""),
       rCase        = createRegexp ("case\b", """case"""),
       rOf          = createRegexp ("of\b", """of"""),
       rEsac        = createRegexp ("esac\b", """esac"""),
       rAt          = createRegexp ("at\b", """at"""),
       rAfter       = createRegexp ("after\b", """after"""),
       rBefore      = createRegexp ("before\b", """before"""),
       rInfix       = createRegexp ("infix\b", """infix"""),
       rInfixl      = createRegexp ("infixl\b", """infixl"""),
       rInfixr      = createRegexp ("infixr\b", """infixr"""),
       rTrue        = createRegexp ("true\b", """true"""),
       rFalse       = createRegexp ("false\b", """false"""),
       rStr         = createRegexp ("str\b", """str"""),
       rSexp        = createRegexp ("sexp\b", """sexp"""),
       rArray       = createRegexp ("array\b", """array"""),
       rBox         = createRegexp ("box\b", """box"""),
       rInfixx      = createRegexp ("[-+*/%$#@!|&^~?<>:=]+", """infix operator"""),
       rLazy        = createRegexp ("lazy\b", """lazy"""),
       rEta         = createRegexp ("eta\b", """eta"""),
       rLet         = createRegexp ("let\b", """let"""),
       rIn          = createRegexp ("in\b", """in"""),
       rPublic      = createRegexp ("public\b", """public"""),
       rImport      = createRegexp ("import\b", """import"""),
       rSyntax      = createRegexp ("syntax\b", """syntax"""),
       rLABEL       = createRegexp ("LABEL\b", """LABEL"""),
       rDUP         = createRegexp ("DUP\b", """DUP"""),
       rDROP        = createRegexp ("DROP\b", """DROP"""),
       rJMP         = createRegexp ("JMP\b", """JMP"""),
       rLDA         = createRegexp ("LDA\b", """LDA"""),
       rLD          = createRegexp ("LD\b", """LD"""),
       rSTI         = createRegexp ("STI\b", """STI"""),
       rSTA         = createRegexp ("STA\b", """STA"""),
       rST          = createRegexp ("ST\b", """ST""");


var comment = syntax (-token["(*"] -token[rComment] -token["*)"]);

var whiteSpace = token (rWhiteSpace); --syntax (-token[rWhiteSpace] | -(comment token[rWhiteSpace])*);

-- Public parsers for concrete tokens
-- Generic token parser; t is either a string or a regular expression
public fun s (t) {whiteSpace |> fun (_) {token(t)}}  -- {(*memo $*) syntax (-whiteSpace token[t])}

-- Some individual tokens
public kSkip    = s (rSkip),
       kIf      = s (rIf),
       kThen    = s (rThen),
       kElse    = s (rElse),
       kElif    = s (rElif),
       kFi      = s (rFi),
       kWhile   = s (rWhile),
       kDo      = s (rDo),
       kOd      = s (rOd),
       kFor     = s (rFor),
       kVar     = s (rVar),
       kVal     = s (rVal),       
       kFun     = s (rFun),
       kCase    = s (rCase),
       kOf      = s (rOf),
       kEsac    = s (rEsac),
       kAt      = s (rAt),
       kAfter   = s (rAfter),
       kBefore  = s (rBefore),
       kInfix   = s (rInfix),
       kInfixl  = s (rInfixl),
       kInfixr  = s (rInfixr),
       kTrue    = s (rTrue),
       kFalse   = s (rFalse),
       kStr     = s (rStr),
       kSexp    = s (rSexp),
       kArray   = s (rArray),
       kBox     = s (rBox),
       kLazy    = s (rLazy),
       kEta     = s (rEta),
       kLet     = s (rLet),
       kIn      = s (rIn),       
       kPublic  = s (rPublic),       
       kImport  = s (rImport),
       kSyntax  = s (rSyntax),
       kLABEL   = s (rLABEL),
       kDUP     = s (rDUP),
       kDROP    = s (rDROP),
       kJMP     = s (rJMP),
       kLDA     = s (rLDA),
       kLD      = s (rLD),
       kSTI     = s (rSTI),
       kSTA     = s (rSTA),
       kST      = s (rST),
       infixx   = memo $ syntax (-whiteSpace located[token(rInfixx)]),
       decimal  = s (rDecimal),       
       chrlit   = syntax (x=s[rChar] {var y = substring (x, 1, x.length - 2);
                                      if y.length == 1
                                      then y [0]
                                      elif y [0] == '\'
                                      then case y [1] of
                                             't' -> '\t'
                                           | 'n' -> '\n'
                                           | _   -> failure ("invalid escape sequence in char literal %s\n", x)
                                           esac
                                      else ''''
                                      fi}),
       strlit   = syntax (x=s[rStrlit] {var j = 0, y = clone (x);
                                        for var i; i := 1,
                                            i < x.length - 1,
                                            j := j + 1
                                        do
                                          case x [i] of
                                            '"' -> y [j] := '"'; i := i + 2
                                          | '\' -> case x [i+1] of
                                                     'n' -> y [j] := '\n'; i := i + 2
                                                   | 't' -> y [j] := '\t'; i := i + 2
                                                   -- Any other backslash stays literal (lamac/Truffle keep
                                                   -- '\X' as backslash + X), e.g. regex escapes \( \* \).
                                                   | _   -> y [j] := '\'; i := i + 1
                                                   esac
                                          | c   -> y [j] := c; i := i + 1
                                          esac
                                        od;
                                        substring (y, 0, j)}),
       pos      = memo $ syntax (-whiteSpace loc),
       end      = memo $ syntax (-whiteSpace eof),
       uident   = memo $ syntax (-whiteSpace located[token(rUident)]), 
       lident   = memo $ syntax (-whiteSpace located[
                                   fun (k) {
                                     fun (s) {
                                       k (case s.matchRegexp (rLident) of
                                            a@Succ (v, _) -> if memSet (keywords, v)
                                                             then Fail ("lowercase identifier expected", s.getLine, s.getCol)
                                                             else a
                                                             fi
                                          | a             -> a
                                          esac)
                                     }
                                   }       
                                ]);


