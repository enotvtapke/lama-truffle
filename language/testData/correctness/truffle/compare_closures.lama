-- Reference Lama `compare` treats closures as compound values: the
-- callTarget is compared first, then captured values are compared
-- element-wise (runtime.c Lcompare, CLOSURE_TAG branch).
--
-- The Truffle port mirrors that as closely as the snapshot-the-whole-
-- frame capture model permits: callTarget identity, then element-wise
-- compare over lexicalScope, with the parent-scope pointer at slot 0
-- compared by identity (so unrelated outer-scope mutations don't
-- destabilise hash-table keys that Ostap's memo depends on).

fun makeAdder (n) {
  var f;
  f := fun (x) { x + n };
  f
}

fun makeSub (n) {
  var f;
  f := fun (x) { x - n };
  f
}

var f;
var g;
var h;
var d;

f := makeAdder (10);
g := makeAdder (10);   -- different instance, same callTarget + captured n
h := makeAdder (20);
d := makeSub   (10);

-- A closure is always equal to itself.
printf ("%d\n", compare (f, f));
printf ("%d\n", compare (d, d));

-- flatCompare: identity-only, so two references to the same closure
-- value are still equal.
printf ("%d\n", flatCompare (f, f));

-- Same callTarget + same captured slot values -> equal (reference
-- behaviour).
printf ("%d\n", compare (f, g));

-- Same callTarget, different captures -> non-zero, sign driven by
-- the captured value (10 - 20 = -10 in the reference).
printf ("%d\n", compare (f, h) < 0);
printf ("%d\n", compare (h, f) > 0);

-- Different callTarget -> never 0.
printf ("%d\n", compare (f, d) == 0);

-- compare is antisymmetric: compare(a, b) + compare(b, a) == 0.
printf ("%d\n", compare (f, g) + compare (g, f));
printf ("%d\n", compare (f, h) + compare (h, f));
printf ("%d\n", compare (f, d) + compare (d, f))
