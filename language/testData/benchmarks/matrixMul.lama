-- Dense square matrix multiplication: nested (2D) array indexing and
-- deeply nested loops. Stresses chained array reads (a[i][k], b[k][j]) and
-- integer multiply/add in the innermost loop.
fun makeMatrix (n, seed) {
  var m = makeArray (n);
  var i, j, row;
  for i := 0, i < n, i := i + 1 do
    row := makeArray (n);
    for j := 0, j < n, j := j + 1 do
      row[j] := (i * 7 + j * 3 + seed) % 100
    od;
    m[i] := row
  od;
  m
}

fun multiply (a, b, n) {
  var c = makeArray (n);
  var i, j, k, row, sum;
  for i := 0, i < n, i := i + 1 do
    row := makeArray (n);
    for j := 0, j < n, j := j + 1 do
      sum := 0;
      for k := 0, k < n, k := k + 1 do
        sum := sum + a[i][k] * b[k][j]
      od;
      row[j] := sum
    od;
    c[i] := row
  od;
  c
}

fun trace (m, n) {
  var i, s;
  s := 0;
  for i := 0, i < n, i := i + 1 do
    s := s + m[i][i]
  od;
  s
}

var n = 175;
var a = makeMatrix (n, 1);
var b = makeMatrix (n, 2);
fun bench () {
  var iter, total;
  total := 0;
  for iter := 0, iter < 12, iter := iter + 1 do
    total := (total + trace (multiply (a, b, n), n)) % 10007
  od;
  total
}
bench
