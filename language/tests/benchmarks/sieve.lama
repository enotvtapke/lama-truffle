-- Sieve of Eratosthenes: array allocation, indexed read/write and tight
-- integer loops. Stresses array-access nodes and loop dispatch.
fun countPrimes (n) {
  var flags = makeArray (n);
  var i, j, count;

  for i := 0, i < n, i := i + 1 do
    flags[i] := 1
  od;

  count := 0;
  for i := 2, i < n, i := i + 1 do
    if flags[i] then
      count := count + 1;
      for j := i + i, j < n, j := j + i do
        flags[j] := 0
      od
    fi
  od;

  count
}

var iter, result;
result := 0;
for iter := 0, iter < 60, iter := iter + 1 do
  result := countPrimes (100000)
od;
write (result)
