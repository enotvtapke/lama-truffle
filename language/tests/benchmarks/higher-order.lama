-- Higher-order functions and closures: a generic summation routine repeatedly
-- driven by freshly created closures that capture their environment. Stresses
-- closure creation, captured-variable reads and indirect (function-value) calls
-- in a hot loop.
fun sumRange (f, n) {
  var i, s;
  s := 0;
  for i := 0, i < n, i := i + 1 do
    s := s + f (i)
  od;
  s
}

fun makeLinear (a, b) {
  fun (x) { a * x + b }
}

fun compose (f, g) {
  fun (x) { f (g (x)) }
}

var iter, total, lin, h;
total := 0;
for iter := 0, iter < 2000, iter := iter + 1 do
  lin := makeLinear (iter % 13, 1);
  h := compose (lin, lin);
  total := total + sumRange (h, 1500)
od;
write (total)
