-- Driver: a top-level compiler utility

import List;
import Ref;
import Array;
import Fun;
import Ostap;
import Parser;
import Matcher;
import Lexer;
import Expr;
import SM;
import X86;
import Timer;
import Manifest;
import SMOptimizer;

-- Parses a command-line arguments, represented as a list, and
-- returns an environment. The environment's interface is
-- defined in the unit Manifest
fun parseArgs (args) {
  var mode      = ref (Build),
      infile    = ref ({}),
      outfile   = ref ({}),
      paths     = ref (case getEnv ("LAMA") of 0 -> {} | s@#str -> {s} esac),
      basename  = ref ({}),
      unit      = ref ({}),
      noImports = ref (false),
      smDump    = ref (false),
      astDump   = ref (false),
      timeDump  = ref (false),
      optMode   = ref (None);

  fun setNoImports () {
    noImports ::= true
  }
  
  fun setDump (m) {
    case m of
      SM   -> smDump   
    | AST  -> astDump  
    | TIME -> timeDump 
    esac ::= true
  }
  
  fun setMode (m) {
    case deref (mode) of
      Build -> mode ::= m
    | _     -> failure ("mode already set: %s\n", deref (mode).string)
    esac
  }

  fun setPath (p) {
    paths ::= deref (paths) +++ {p}
  }

  fun setInFile (fn) {
    case deref (infile) of
      {} -> case parseString (syntax (token["/"]? (token[createRegexp ("[-a-z_A-Z0-9']+", "test")] token["/"])* name=(uident | lident) token[".lama"] eof {name}), fn) of
              Fail (_, _, _) -> failure ("filename ""%s"" does not comply the pattern <uident/lident>.lama\n", fn)
            | Succ (name)    -> infile ::= fn;
                                basename ::= name;
                                unit     ::= case clone (name) of name -> name[0] := uppercase (name [0]); name esac
            esac
            
    | _  -> failure ("omitting ""%s"", input file name already set to ""%s""\n", fn, deref (infile))
    esac
  }

  fun setOutFile (fn) {
    case deref (outfile) of
      {} -> outfile ::= fn
    | _  -> failure ("omitting ""%s"", output file name already set to ""%s""\n", fn, deref (outfile))
    esac
  }

  fun setOptMode (opt) {
    optMode ::= opt
  }

  fix (fun (rec) {
         fun (args) {
            case args of
              {}    -> skip
            | h : t ->
               rec $
               case h of
                 "-i"         -> setMode (Int); t
               | "-c"         -> setMode (Comp); t
               | "-o"         -> case t of
                                   {}     -> failure ("file name expected after ""-o"" option\n")
                                 | fn : t -> setOutFile (fn); t
                                 esac
               | "-s"         -> setMode (SM); t
               | "-ds"        -> setDump (SM); t
               | "-dp"        -> setDump (AST); t
               | "-dt"        -> setDump (TIME); t
               | "-noimports" -> setNoImports (); t
               | "-I"         -> case t of
                                   {}    -> failure ("path expected after ""-I"" option\n")
                                 | p : t -> setPath (p); t
                                 esac
               | "-O"         -> case t of 
                                   {} -> failure ("optimization settings expected after ""-O"" option\n")
                                 | h : t -> setOptMode (Some (h)); t
                                 esac
               | fn           -> setInFile (fn); t
               esac
            esac
         }
      })(args);

  [fun () {deref (mode)},
   fun () {case deref(infile) of #val -> failure ("input file name not set\n") | fn -> fn esac},
   fun () {deref (smDump)},
   fun () {deref (astDump)},
   fun () {deref (timeDump)},
   fun () {deref (basename)},
   fun () {deref (unit)},
   fun () {deref (paths)},
   fun () {
     case deref (outfile) of
       {} -> deref (basename)
     | fn -> fn
     esac
   },
   fun () {
     deref (noImports)
   },
   fun () {
    deref (optMode)
   }
  ]        
}

-- Logging
fun createLog (args) {
  var ast        = ref ({}),
      sm         = ref ({}),
      parseTime  = ref (None),
      smTime     = ref (None),
      x86Time    = ref (None),
      evalTime   = ref (None),
      evalSMTime = ref (None);
        
  fun logAST (p, t) {
    ast ::= p;
    parseTime ::= Some (t);
    p
  }

  fun logSM (p, t) {
    sm ::= p;
    smTime ::= Some (t);
    p
  }

  fun logX86 (t) {
    x86Time ::= Some (t)
  }

  fun logEval (t) {
    evalTime ::= Some (t)
  }

  fun logSMEval (t) {
    evalSMTime ::= Some (t)
  }

  fun print () {
    fun printTime (memo, p) {
      case p of
        None     -> skip
      | Some (t) -> printf ("%s: %s\n", memo, toSeconds (t))
      esac
    }

    dumpAST (args, lazy (deref (ast).string));
    dumpSM  (args, lazy (showSM (deref $ sm)));

    if args [4] () then
      printTime ("Parsing time          ", deref (parseTime));
      printTime ("SM compile time       ", deref (smTime));
      printTime ("X86 compile time      ", deref (x86Time));
      printTime ("Interpretation time   ", deref (evalTime));
      printTime ("SM interpretation time", deref (evalSMTime))
    fi
  }

  [logAST,
   logSM,
   logX86,
   logEval,
   logSMEval,
   print
  ]   
}

-- Accessor functions
fun logAST (log, p, t) {
  log [0] (p, t)
}

fun logSM (log, p, t) {
  log [1] (p, t)
}

fun logX86 (log, t) {
  log [2] (t)
}

fun logEval (log, t) {
  log [3] (t)
}

fun logSMEval (log, t) {
  log [4] (t)
}

fun print (log) {
  log [5] ()
}

var args = parseArgs (arrayList (sysargs).tl), t = timer (), log = createLog (args);

-- The main part: parses input file, invokes interpreter/stack machine interpreter/x86
-- code generator

fun native (args, context, program) {
  case log.logSM (compileSM (args, context, program), t ()) of
    sm -> t := timer ();
          compileX86 (args, context, optimizeSM (args, context, sm));
          log.logX86 (t ())
  esac
}

var tt = timer ();
-- printf ("Parsing...");

case parseString (syntax (parseUnit[args] -end), fread (args.getInFile)) of
  Succ (f) ->
--    printf ("Parsing time: %s\n", toSeconds $ tt ());
--    printf ("done\n");
--    printf ("Making AST...");
    case f () of
      [context, program] ->
  --  printf ("done\n");
    log.logAST (program, t ());
    t := timer (); 
    case args.getMode of 
      Comp  -> native (args, context, program)
               
    | Build -> native (args, context, program)
               
    | mode ->
        var input =
           reverse (fix (fun (f) {
                           fun (acc) {
                             case readLine () of
                               #val -> acc
                             | arg  -> f (stringInt (arg) : acc) esac
                           }
                         }) ({}));

        iter (fun (x) {printf ("%d\n", x)},
              case mode of
                Int -> var out = evalExpr (input, program);
                       log.logEval (t ());
                       out
                      
              | SM  -> var sm = log.logSM (compileSM (args, context, program), t ()), out;                      
                       t := timer ();  log.print;
                       out := evalSM (input, optimizeSM (args, context, sm));
                       log.logSMEval (t ());
                       out
              esac) 
    esac; 
    log.print
    esac
| x@Fail (err, line, col) ->   
   failure ("%s at %d:%d\n", err.hd, line, col)
esac
