import Ostap;
import Matcher;

var decimal = createRegexp ("[0-9]+", "decimal"),
    ident   = createRegexp ("[a-z]+", "identifier"),
    r;

r := parseString (
  syntax (token[decimal] -eof { "number" }
        | token[ident] -eof { "word" }),
  "hello"
);

case r of
  Succ (v) -> printf ("%s\n", v)
| Fail (e, l, c) -> printf ("FAIL\n")
esac;

r := parseString (
  syntax (token[decimal] -eof { "number" }
        | token[ident] -eof { "word" }),
  "42"
);

case r of
  Succ (v) -> printf ("%s\n", v)
| Fail (e, l, c) -> printf ("FAIL\n")
esac
