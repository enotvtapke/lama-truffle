-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;
import Ref;
import Collection;
import STM;
import Buffer;
import Manifest;
import Infix;
import Interface;
import Timer;

-- AST environment
fun createEnv (id, unitName_, implicitImports) {
  fun freshName () {
    [createEnv (id+1, unitName_, implicitImports), sprintf ("_tmp%d", id)]
  }
 
  fun unitName () {
    unitName_
  }

  fun addImplicitImport (name) {
    createEnv (id, unitName_, if compare (name, unitName_) == 0
                              then implicitImports
                              else addSet (implicitImports, name) fi)
  }

  fun getImplicitImports () {
    elements (implicitImports)
  }
  
  [freshName,
   unitName,
   addImplicitImport,
   getImplicitImports]
}

fun emptyEnv (unitName) {
  createEnv (0, unitName, emptySet (compare))
}

fun freshName (env) {
  env [0] ()
}

fun unitName (env) {
  env [1] ()
}

fun addImplicitImport (env, name) {
  env [2] (name)
}

fun getImplicitImports (env) {
  env [3] ()
}

-- Attribute-processing functions
-- Attributes are:
--   Val  --- a plain value (aka "rvalue")
--   Ref  --- a reference to a mutable cell (aka "lvalue")
--   Void --- no value (aka "void"/"unit")
--   Weak --- works like Val, but allows to provide a "default" value for void constructs

-- Checks if a plain value "val" can be used in the context described by
-- the attribute "atr".
fun assertValue (atr, value, loc) {
  case atr of
    Ref  -> error ("reference expected", loc)
  | Void -> value => fun (value) {Ignore (value)}
  | _    -> value
  esac
}

-- Checks if a void epxression can be used in the context described by
-- the attribute "atr".
fun assertVoid (atr, value, loc) {
  case atr of
    Void -> value
  | Val  -> error ("value expected", loc)
  | Weak -> value => fun (value) {Seq (value, Const (0))}
  | _    -> error ("reference expected", loc)
  esac
}

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- An infixExpression parser table; an ugly hack until
-- circular structures are fully supported
var infixExpression = makeArray (1024);

-- A helper function to reify infix table into a parser
fun reifyInfixes (infixTable, level) {
  -- A helper function to be used with super-combinator "expr"
  fun binop ([op, fn]) {
    [syntax (pos -s[op]), fun (l, loc, r) {
                            fun (a) {
                              assertValue (a, l (Val) =>> fun (l) {
                                              r (Val) =>  fun (r) {
                                                addLoc (op, loc);
                                                case fn of
                                                  Std         -> Binop (op, l, r)
                                                | Custom (fn) -> Call  (Var (Infix (fn, op)), {l, r}, loc)
                                                esac
                                              }}, loc)
                            }
                          }
    ]
  }
  
  if level >= infixExpression.length
    then failure ("infix table overflow\n")
  fi;
  
  infixExpression[level] := [
    infixTable, 
    expr (
      case foldl (
             fun ([set, acc], [assty, ops]) {
               case foldl (
                      fun ([set, acc], op@[inf, _]) {
                        if memSet (set, inf) then [set, acc]
                        else [addSet (set, inf),
                              if compare (inf, ":=") == 0
                              then [s (":="), fun (l, loc, r) {
                                                fun (a) {assertValue (a, l (Ref) =>> fun (l) {
                                                                         r (Val) =>  fun (r) {
                                                                         Assn (l, r)
                                                                         }}, loc)
                                   }}] : acc
                              elif compare (inf, ":") == 0
                              then [s (":"), fun (l, loc, r) {
                                               fun (a) {assertValue (a, l (Val) =>> fun (l) {
                                                                        r (Val) =>  fun (r) {
                                                                        Sexp ("cons", {l, r})
                                                                        }}, loc)
                                   }}] : acc
                              else binop (op) : acc
                              fi]
                        fi
                      },
                      [set, {}],
                      ops)  of
                  [set, {}]  -> [set, acc]
               |  [set, ops] -> [set, [assty, ops] : acc]
               esac                                
             },
           [emptySet (compare), {}],
           infixTable) of
        [_, ops] -> reverse (ops)   
      esac, 
      eta (postfix (level)))]
}

-- Helper parser: parses a (possible empty) list of items separated by ","
fun list0 (item) {
  list0By (item, s(","))
}

-- Helper parser: parses a non-empty list of items separated by ","
fun list (item) {
  listBy (item, s(","))
}

-- Helper AST function: expands a "raw" scope expression, reifying
-- initializers into assignments
fun expandScope (defs, expr) {
  fun expandVarDefs (defs, expr) {
    foldr (fun ([defs, expr], def) {     
             case def of
                [ident, None]         -> [ident : defs, expr]
             |  [ident, Some (value)] -> [ident : defs, Seq (Ignore (Set (ident, value)), expr)]
             esac
           },
           [{}, expr],
           defs)
  }

  fun expandValDefs (defs, expr) {
    foldr (fun ([defs, expr], [ident, value]) {     
             [ident : defs, Seq (Ignore (Set (ident, value)), expr)]
           },
           [{}, expr],
           defs)
  }
  
  case 
    foldr (fun ([defs, expr], def) {
             case def of 
               f@Fun (_, _, _, _, _) -> [f : defs, expr]
             
             | Val (p, unit, ds) ->
                 case expandValDefs (ds, expr) of
                   [ds, expr] -> [Val (p, unit, ds) : defs, expr]
                 esac
                 
             | Var (p, unit, ds) ->             
                 case expandVarDefs (ds, expr) of
                   [ds, expr] -> [Var (p, unit, ds) : defs, expr]
                 esac
             esac
           },
           [{}, expr],
           defs) of
    [defs, expr] -> Scope (defs, expr)
  esac  
}

-- Helper AST function: distributes a scope through an expression
fun distributeScope (expr, exprConstructor) {
  case expr of
    Scope (defs, sexpr) -> Scope (defs, exprConstructor (sexpr))
  | _                   -> exprConstructor (expr)
  esac
}

-- Helper AST function: reifies pattern bindings into scope
-- definitions and assignments; takes an returns lists of
-- pattern-branch pairs
fun reifyPatternBindings (unit, matched, brs) {
  map (
    fun ([pat, br]) {      
      fun collectBindings (path, p) {
        fun collectList (path, ps) {
          case
            foldl (fun ([acc, i], p) {
                     [collectBindings (i : path, p) : acc, i+1]                      
                   },
                   [{}, 0],
                   ps) of
            [acc, _] -> flatten (acc)
          esac            
        }
        
        case p of
          Sexp  (_, ps)   -> collectList (path, ps)
        | Array (ps)      -> collectList (path, ps)
        | Named (name, p) -> [name, path] : collectBindings (path, p)
        |  _              -> {}
        esac
      }

      case collectBindings ({}, pat) of
        {}       -> [pat, br]
      | bindings ->
           [pat,
            expandScope (
              {Val (false, unit, map (
                                      fun ([name, path]) {
                                           [name, foldr (fun (p, i) {Elem (p, Const (i))}, Var (matched), path)]
                                      },
                                      bindings))},
               br
             )]
      esac
    },
    brs
  )
}

-- Helper function: creates a global name 
public fun globalName (unit, localName) {
  unit ++ "_" ++ case localName of Init -> "init" | _ -> localName esac
}

-- Helper function: makes a qualified name
fun withQName (unitName, name, loc, f) {
  case [sprintf ("%s.%s", unitName, name), globalName (unitName, name)] of
    [reprName, innerName] -> addLoc (reprName, loc);
                             f (Qname (innerName, reprName))                                              
  esac
}

-- Custom infix operators helpers
fun prefixInfixName (p, inf) {
  var b = singletonBuffer (p);
  for var i = 0;, i < inf.length, i := i+1 do
    b := b <+ sprintf ("%d", inf[i])
  od;
  
  b.getBuffer.stringcat
}

fun infixName (inf) {
  prefixInfixName ("i__Infix_", inf)
}

fun registerInfix (level, ass, inf, pos, fn, loc) {
  case addInfix (infixExpression[level][0], pos, ass, inf, fn, loc) of
    infixTable -> reifyInfixes (infixTable, level+1); level+1
  esac
}

var
  args = memo $ eta syntax (
    ps=inbr[s("("), list0(syntax (pos pattern)), s(")")] {
      fun (env) {
        [env, 
         fun (e) {
          case foldr (fun ([acc, i], _) {[sprintf ("_a%d", i) : acc, i+1]}, [{}, 0], ps) [0] of
             args ->
               foldr (fun ([[args, e], i], [a, [loc, p]]) {
                        [case p of
                           Named (a, Wildcard) -> addLoc (a, loc);
                                                  [a : args, e]
                         | Wildcard -> addLoc (a, loc);
                                       [a : args, e]
                         |  _       -> addLoc (a, loc); 
                                       [a : args, Case (a, reifyPatternBindings (env.unitName, a, {[p, e]}), loc)]
                         esac, i-1]
                      }, [[{}, e], size (ps)], zip (args, ps)) [0] 
           esac
         }]
      }
    }
  );
  
  -- let  
  fun letexp (pa) {
    syntax (
      loc=pos kLet p=pattern s["="] e=letexp[pa] kIn b=letexp[pa] {
        fun (a) {
          e (Val) =>> fun (e) {
          b (a)   =>> fun (b) {
            fun (env) {
              case env.freshName of
                [env, matched] ->
                   addLoc (matched, loc);
                   [env, expandScope ({Val (false, env.unitName, {[matched, e]})},
                                      Case (matched, reifyPatternBindings (env.unitName, matched, {[p, b]}), loc))]
              esac
            }
          }}
        }
      } |
      exp[pa]
    )}
  
  fun primary (pa) {
    syntax (
      -- Boolean constants
      loc=pos kTrue  {fun (a) {assertValue (a, returnST $ Const (1), loc)}} |

      loc=pos kFalse {fun (a) {assertValue (a, returnST $ Const (0), loc)}} |
    
      -- list
      loc=pos x=inbr[s("{"), list0(syntax (e=letexp[pa] {e(Val)})), s("}")] {
        fun (a) {assertValue (a, chainST (x) => fun (x) {
                                   foldr (fun (acc, x) {Sexp ("cons", {x, acc})}, Const (0), x)
                                 }, loc)}
      } |
    
      -- array constant
      loc=pos x=inbr[s("["), list0(syntax (e=letexp[pa] {e(Val)})), s("]")] {
        fun (a) {assertValue (a, chainST (x) => fun (x) {Array (x)}, loc)}
      } |
                                      
      -- string constant
      loc=pos x=strlit {
        fun (a) {assertValue (a, returnST $ String (x), loc)}
      } |
                                      
      -- character literal
      loc=pos x=chrlit {
        fun (a) {assertValue (a, returnST $ Const (x), loc)}
      } |
                                      
      -- decimal constant
      loc=pos x=decimal {
        fun (a) {assertValue (a, returnST $ Const (stringInt (x)), loc)}
      } |
                                      
      -- identifier
      loc=pos x=lident {
        fun (a) {
          returnST $ case a of
                       Ref  -> Ref (x)
                     | Void -> Ignore (Var (x))
                     | _    -> Var (x)
                     esac
          }
      } |

      -- S-expression
      loc=pos x=uident {fun (a) {assertValue (a, returnST $ Sexp (x, {}), loc)}} |

      -- Lambda
      kFun fb=args body=inbr[s ("{"), scopeExpr(pa), s ("}")] {
        fun (a) {assertValue (a, body (Weak) =>> fun (body) {
                                 fb          =>  fun (fb)   {
                                                    case fb (body) of [args, body] -> Lambda (args, body) esac
                                 }}, loc)}
      } |
      
      -- skip
      loc=pos kSkip {
        fun (a) {assertVoid (a, returnST $ Skip, loc)}
      } |

      -- Infix capturing
      loc=pos kInfix q=(uident -s["."])? inf=infixx {
        case if compare (inf, ":=") == 0
             then error ("assignment operator can not be captured", loc)
             else [q, infixName (inf)]
             fi of
          [None, fn] -> reLoc (inf, fn);
                        fun (a) {assertValue (a, returnST $ Var (Infix (fn, inf)), loc)}
        | [Some (q), fn] ->
            case globalName (q, fn) of
              fn -> reLoc (inf, fn);
                    fun (a) {assertValue (a, fun (env) {
                                               case env.addImplicitImport (q) of
                                                 env -> [env, Var (Infix (fn, inf))]
                                               esac
                                             }, loc)}    
            esac
        esac 
      } |
    
      -- while e do b
      loc=pos kWhile e=letexp[pa] b=inbr[kDo, scopeExpr(pa), kOd] {
        fun (a) {
          assertVoid (a, e (Val)  =>> fun (e) {
                         b (Void) =>  fun (b) {
                           While (e, b)
                         }},
                      loc)
        }
      } |
                                    
      -- repeat s until e
      loc=pos kDo s=scopeExpr[pa] kWhile e=letexp[pa] kOd {
        fun (a) {
          assertVoid (a, s (Void) =>> fun (s) {
                         e (Val)  =>  fun (e) {
                           distributeScope (s, fun (s) {DoWhile (s, e)})
                         }},
                      loc)
        }
      } |
  
      -- for init, cond, step do S od --> init; while cond do S; step od
      loc=pos kFor init=scopeExpr[pa] s[","] cond=letexp[pa] s[","] step=letexp[pa] body=inbr[kDo, scopeExpr(pa), kOd] {
        fun (a) {
          assertVoid (a, init (Void) =>> fun (init) {
                         cond (Val)  =>> fun (cond) {
                         body (Void) =>> fun (body) {
                         step (Void) =>  fun (step) {
                           distributeScope (init, fun (init) {Seq (init, While (cond, Seq (body, step)))})
                         }}}},
                       loc)
        }
      } |
  
      -- if ...
      -kIf ifPart[pa] -kFi |
                                      
      -- case
      kCase loc=pos c=letexp[pa] kOf brs=caseBranches[pa] kEsac {
        fun (a) {
          c (Val) =>> fun (c) {
          chainST $ map (fun ([p, b]) {fun (env) {case b (a) (env) of [env, b] -> [env, [p, b]] esac}}, brs) =>> fun (brs) {
            fun (env) {
              case env.freshName of
                [env, matched] ->
                  addLoc (matched, loc);
                  [env, expandScope ({Val (false, env.unitName, {[matched, c]})},
                                     Case (matched, reifyPatternBindings (env.unitName, matched, brs), loc)
                        )
                  ]
              esac}}}
        }} |
                                      
      -- ( e )
      inbr[s ("("), scopeExpr(pa), s (")")] |

      -- eta
      loc=pos kEta e=basic[pa] {
        fun (a) {
          e (a) =>> fun (e) {
            fun (env) {
              case env.freshName of
                [env, arg] ->
                  addLoc (arg, loc);
                  [env, Lambda ({arg}, Call (e, {Var (arg)}, loc))]
              esac
            }
          }
        }
      } |

      -- lazy
      loc=pos kLazy e=basic[pa] {
        fun (a) {
          e (a) =>> fun (e) {
          fun (env) {
            withQName ("Lazy", "makeLazy", loc, fun (qn) {[env.addImplicitImport ("Lazy"), Call (Var (qn), {Lambda ({}, e)}, loc)]})}
          }
        }
      } |

      loc=pos kSyntax e=inbr[s("("), syntaxExpr(pa), s(")")] {
        fun (a) {
          assertValue (a, e (a) =>> fun (e) {
                          fun (env) {
                            [env.addImplicitImport ("Ostap"), e]
                          }},
                       loc)
        }
      }
    )}

  fun syntaxExpr (pa) {
    expr (
      {[Right, {[s ("|"), fun (l, loc, r) {fun (a) {
                                             l (a) =>> fun (l) {
                                             r (a) =>  fun (r) {
                                             withQName ("Ostap", "alt", loc, fun (qn) {Call (Var (qn), {l, r}, loc)})
                                             }}
                                           }}]}]
     }, 
     syntaxSeq (pa)
    )
  }

  fun syntaxSeq (pa) {
    syntax (
      sq=syntaxBinding[pa]+ loc=pos sema=inbr[s("{"), scopeExpr(pa), s("}")]? {
        fun (a) {
          case sq of          
            [loc, omit, pat, p] : ss ->              
              p (a) =>> fun (p) {              
                fun twoHoles (loc, s, p) {
                  fun (f, x) {
                    fun (env) {
                      case p of
                        Some (Named (a, Wildcard)) -> [env, Call (f, {s, Lambda ({a}, x)}, loc)]
                      | _ ->
                         case env.freshName of
                           [env, a] -> [env, Call (f, {s, Lambda ({a}, case p of
                                                                         None     -> x
                                                                       | Some (p) -> Case (a, reifyPatternBindings (env.unitName, a, {[p, x]}), loc)
                                                                       esac)
                                                      }, loc)]
                         esac
                      esac
                  }}
                }
                
                fun preprocess (acc, omit, pat) {
                  fun (env) {
                    case omit of
                      Some (_) -> [env, [acc, pat]]
                    | None     -> case pat of
                                    Some (Named (a, _)) -> [env, [Var (a) : acc, pat]]
                                  | _ -> case env.freshName of
                                           [env, a] -> [env, [Var (a) : acc, Some (Named (a, case pat of
                                                                                               None     -> Wildcard 
                                                                                             | Some (p) -> p             
                                                                                             esac))]]
                                         esac
                                  esac
                    esac
                  }
                }
                
                case foldl (fun (acc, [loc, omit, pat, p]) {                              
                              p (a)                          =>> fun (p)     {
                              acc                            =>> fun ([defSem, holes]) {
                              preprocess (defSem, omit, pat) =>  fun ([acc, pat]) {                           
                                [acc, fun (f, x) {
                                        withQName ("Ostap", "seq", loc, fun (qn) {
                                                                          twoHoles (loc, p, pat) (f, x) =>> fun (twoH) {
                                                                             holes    (Var (qn), twoH)
                                                                           }})
                                      }]}
                              }}
                            },
                            preprocess ({}, omit, pat) => fun ([acc, pat]) {
                               [acc, twoHoles (loc, p, pat)]
                            },
                            ss) of
                  seqp -> seqp =>> fun ([defSema, seqp]) {
                            case sema of
                              None        -> withQName ("Ostap", infixName ("@"), loc, fun (qn) {seqp (Var (qn), case defSema of
                                                                                                                  {x} -> x
                                                                                                                 | _  -> Array (reverse $ defSema)
                                                                                                                 esac)})
                            | Some (sema) -> sema (Val) =>> fun (sema) {withQName ("Ostap", infixName ("@"), loc, fun (qn) {seqp (Var (qn), sema)})}
                            esac
                          }
                esac
              }
          esac
        }
      }
    )
  }
  
  fun syntaxBinding (pa) {
    syntax (pos s["-"]? (pattern -s["="])? syntaxPostfix[pa])
  }

  fun syntaxPostfix (pa) {
    syntax (
      b=syntaxPrimary[pa] loc=pos p=(s["*"] {"rep0"} | s["+"] {"rep"} | s["?"] {"opt"})? {
        fun (a) {
          b (a) => fun (b) {
          case p of
            None       -> b
          | Some (mod) -> withQName ("Ostap", mod, loc, fun (qn) {Call (Var (qn), {b}, loc)})
          esac
        }}}      
    )
  }

  fun syntaxPrimary (pa) {
    syntax (
      loc=pos ui=(uident -s["."])? p=lident args=inbr[s("["), list(exp(pa)), s("]")]? {
        fun (a) {
          case case args of
                 None        -> returnST $ fun (p, loc) {p}
               | Some (args) -> chainST $ map (fun (arg) {arg (Val)}, args) => fun (args) {
                                  fun (p, loc) {Call (p, args, loc)}
                                }
               esac of
            args ->
              args => fun (args) {
              case ui of
                None      -> args (Var (p), loc)
              | Some (ui) -> withQName (ui, p, loc, fun (qn) {args (Var (qn), loc)})
              esac}
          esac
        }
      }
    | inbr[s("("), syntaxExpr(pa), s(")")]
    | inbr[s("$("), scopeExpr(pa), s(")")]
    )
  }

  fun elsePart (pa) {
    syntax (
      loc=pos {fun (a) {assertVoid (a, returnST $ Skip, loc)}}
    | -kElse scopeExpr[pa]
    | -kElif ifPart[pa]
    )}
  
  fun thenPart (pa) {syntax (-kThen scopeExpr[pa])}
  
  fun ifPart (pa) {
    syntax (
      cond=letexp[pa] th=thenPart[pa] el=elsePart[pa] {
        fun (a) {cond (Val) =>> fun (cond) {
                 th   (a)   =>> fun (th)   {
                 el   (a)   =>  fun (el)   {
                   If (cond, th, el)
                }}}}
      }
    )}

  var 
  patternPrimary = memo $ eta syntax (
    c=chrlit                                              {Const (c)}                                                                   |
    s=strlit                                              {String (s)}                                                                  |
    m=(s["-"])? x=decimal                                 {Const (fun (x) {case m of Some (_) -> 0 - x | _ -> x esac} $ stringInt (x))} |
    kTrue                                                 {Const (1)}                                                                   |
    kFalse                                                {Const (0)}                                                                   |
    s["#"] kBox                                           {Boxed}                                                                       |
    s["#"] kVal                                           {UnBoxed}                                                                     |
    s["#"] kStr                                           {String}                                                                      |
    s["#"] kSexp                                          {Sexp}                                                                        |
    s["#"] kArray                                         {Array}                                                                       |
    s["#"] kFun                                           {Closure}                                                                     |
    s["_"]                                                {Wildcard}                                                                    |
    c=uident args=inbr[s ("("), list (pattern), s (")")]? {Sexp (c, case args of Some (args) -> args | None -> {} esac)}                |
    a=inbr[s ("["), list0 (pattern), s ("]")]             {Array (a)}                                                                   |
    l=inbr[s ("{"), list0 (pattern), s ("}")]             {foldr (fun (acc, x) {Sexp ("cons", {x, acc})}, Const (0), l)}         |
    x=lident p=(-s["@"] patternPrimary)?                  {case p of Some (p) -> Named (x, p) | None -> Named (x, Wildcard) esac }      |
    inbr[s ("("), pattern, s (")")]                       
  ),

  pattern = expr ({[Right, {[s (":"), fun (l, loc, r) {Sexp ("cons", {l, r})}]}]}, patternPrimary);
  
  fun caseBranches (pa) {
    syntax (
      listBy [syntax (pattern -s["->"] scopeExpr[pa]), s ("|")]
    )}
  
  fun basic (pa) {
     infixExpression [pa][1]
  }
  
  fun postfix (pa) {
    syntax (
      loc=pos e=primary[pa] ps=(i=inbr[s("["), letexp(pa), s("]")]                          {Index (i (Val))} |
                            s["."] fn=lident                                                {Dot   (fn)     } |
                            args=inbr[s("("), list0(syntax(e=letexp[pa] {e(Val)})), s(")")] {Call  (args)   })* {
        fun (a) {
          foldl (fun ([e, rest], p) {
                   fun fixICall (e) {
                     case e of
                       ICall (callee, args, loc) -> Call (callee, args, loc)
                     | _                         -> e
                     esac
                   }
                 
                   [case p of                                                                                                       
                      Index (i) ->
                       fun (a) {
                         case a of
                           Ref -> e (Val) =>> fun (e) {
                                  i       =>  fun (i) {
                                  ElemRef (fixICall $ e, i)
                                }} 
                         | _   -> assertValue (a, e (Val) =>> fun (e) {
                                                  i       =>  fun (i) {
                                                  Elem (fixICall $ e, i)
                                                  }},
                                               loc)
                         esac
                       }
                    | Dot  (fn)   -> fun (a) {assertValue (a, e (Val) =>> fun (e) {
                                                                            fun (env) {
                                                                              case e of
                                                                                Sexp (ui, {}) ->
                                                                                  case ui ++ "." ++ fn of
                                                                                    reprName ->
                                                                                      case globalName (ui, fn) of
                                                                                        innerName -> reLoc (ui, reprName);
                                                                                                     [env.addImplicitImport (ui), Var (Qname (innerName, reprName))]
                                                                                      esac
                                                                                  esac       
                                                                              | _ ->
                                                                                 [env, case rest of
                                                                                         {} -> Call  (Var (fn), {fixICall $ e}, loc)
                                                                                       | _  -> ICall (Var (fn), {fixICall $ e}, loc)
                                                                                       esac]
                                                                              esac}}, loc)}
                    | Call (args) ->
                       fun (a) {
                         assertValue (a, e (Val)        =>> fun (e) {
                                         chainST (args) =>  fun (args) {
                                           case e of
                                             Sexp (t, {})      -> Sexp (t, args)
                                           | ICall (c, {a}, _) -> Call (c, a : args, loc)
                                           | _                 -> Call (e, args, loc)
                                           esac
                                         }}, loc)
                       }
                    esac, case rest of {} -> {} | _ -> tl $ rest esac]
                 }, [e, case ps of {} -> {} | _ -> tl $ ps esac], ps) [0] (a)
        }}
  )}

  fun definitions (pa) {
    syntax (
      [s, pa_]=definition[pa] [ss, pa__]=definitions[pa_] {[s:ss, pa__]}
    | empty {[{}, pa]}
    )
  }
  
  fun scopeExpr (pa) {
    syntax ([ds, pa_]=definitions[pa]  loc=pos e=letexp[pa_]? {
      fun (a) {
        fun (e) {
          case ds of
            {} -> e => fun (e) {Scope ({}, e)}
          | _  -> chainST (ds) =>> fun (ds) {
                  e            =>  fun (e)  {
                    expandScope (ds, e)
                  }}
          esac
        }
        (case e of 
          Some (e) -> e (a)
        | _        -> assertVoid (a, returnST $ Skip, loc)
        esac)
      }}                                                                  
    )}

  fun infixHeader (pa) {
    syntax (
      p      = publicity
      loc    = pos
      ass    = (kInfix {Nona} | kInfixr {Right} | kInfixl {Left})
      inf    = infixx
      level  = ( kAt     {fun (x) {At     (x)}}
               | kBefore {fun (x) {Before (x)}}
               | kAfter  {fun (x) {After  (x)}})
      anchor = infixx {
        case infixName (inf) of
          fn -> reLoc (inf, fn);              
                [p, loc, inf, fn, [ass, level (anchor)], registerInfix (pa, ass, inf, level (anchor), fn, loc)]
        esac
      }
    )}
  
  fun infixdef (pa) {
    syntax (
      [p, loc, inf, fn, spec, pa_] = infixHeader[pa]
      fb                           = args
      body                         = inbr[s("{"), scopeExpr(pa_), s("}")] {
        [body (Weak) =>> fun (body) {
         fb          =>> fun (fb)   {
                         fun (env)  {
                           case fb (body) of
                             [args, body] ->
                                if args.size != 2 then error ("custom infix operator should recieve two arguments", loc) fi;
                                [env, Fun (p, env.unitName, Infix (fn, inf, spec), args, body)]
                           esac
                         }}},
         pa_]
      }
    )}

  var publicity = memo $ eta syntax (p=kPublic? {case p of None -> false | _ -> true esac});
  
  fun definition (pa) {
    syntax (
      p=publicity  kVar ds=list[syntax (x=lident e=(-s["="] basic[pa])? {case e of
                                                                           None -> returnST $ [x, None]
                                                                         | Some (e) ->
                                                                           e (Val) => fun (e) {[x, Some (e)]}
                                                                         esac})] s[";"] {
        [chainST (ds) =>> fun (ds) {fun (env) {
                                     [env, Var (p, env.unitName, ds)]
                                   }}, pa]
      } |
      p=publicity kVal ds=list[syntax (x=lident s["="] e=basic[pa] {e (Val) => fun (e) {[x, e]}})] s[";"] {
        [chainST (ds) =>> fun (ds) {
                            fun (env) {
                              [env, Val (p, env.unitName, ds)]
                            }},
         pa]
      } |
      p=publicity kFun name=lident fb=args body=inbr[s("{"), scopeExpr(pa), s("}")] {
        [body (Weak) =>> fun (body) {
         fb          =>> fun (fb)   {              
                         fun (env) {
                           [env,
                            case fb (body) of
                              [args, body] -> Fun (p, env.unitName, name, args, body)
                            esac]
                         }
                        }},         
         pa]
      } |
      infixdef[pa]
    )}
  
  fun exp (pa) {
    syntax (
      basic[pa]
    | s1=basic[pa] s[";"] s2=letexp[pa] {
       fun (a) {
         s1 (Void) =>> fun (s1) {
         s2 (a)    =>  fun (s2) {
           Seq (s1, s2)
         }}
       }
     }
    )}

fun imports (noImports, paths, context) {
  memo $ syntax (p=pos is=(pos -kImport uident -s[";"])* {
    foldl (if noImports
           then fun (c, _) {c}
           else fun (c, [loc, importName]) {loadInterface (paths, importName, true, c)}
           fi, context, [p, "Std"] : is)
  })
}

-- Public top-level parser
public fun parseUnit (args) {
  syntax (c=imports[args.noImports, args.getPaths, createContext (predefinedOps,
                                                                  fun (infixTable, ass, inf, pos) {
                                                                    addLoc (inf, loc);
                                                                    addInfix (infixTable, pos, ass, inf, infixName (inf), loc)
                                                                  })]
          s=scopeExpr[(reifyInfixes (c.getInfixTable, 0); 0)] {fun () {
                            case s (Void) (emptyEnv (args.getUnitName)) of
                              [env, ast] ->
                                 case foldl (fun (c, importName) {
                                               loadInterface (args.getPaths, importName, false, c)
                                             },
                                             c,
                                             env.getImplicitImports) of
                                   c -> [c, ast]
                                 esac
                            esac}}
  )
}
