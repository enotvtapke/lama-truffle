-- Custom infix processing

import List;
import Array;
import Ostap;
import STM;
import Fun;
import Manifest;

-- Predefined infix operators; this structure is maintained
-- as the new custom infixes are added
public predefinedOps = {
  [Right, {[":=", Std]}],
  [Right, {[":" , Std]}],
  [Left,  {["!!", Std]}],
  [Left,  {["&&", Std]}],
  [Nona,  {["==", Std], ["!=", Std], ["<", Std], [">", Std], ["<=", Std], [">=", Std]}],
  [Left,  {["+" , Std], ["-", Std]}],
  [Left,  {["*" , Std], ["/", Std], ["%", Std]}]
};

-- Checks if an infix operator corresponds to a predefined
-- one
public fun predefined (inf) {
  findArray (fun ([_, ops]) {
               find (fun ([x, _]) {compare (x, inf) == 0}, ops) != None
             }, predefinedOps) != None
}

-- Insert a new infix into an existing infix structure.
-- pos is a position specifier in the form
--   After (inf) / Before (inf) / At (inf)
-- assty is associativity specifier in the form
--   Left / Right / Nona
-- inf is an infix sign
-- name is an internal function name associated with
--   the infix
-- loc is the location of the infix definition
public fun addInfix (infixes, pos, assty, inf, name, loc) {
  var anchor = case pos of
                 After  (inf) -> inf
               | Before (inf) -> inf
               | At     (inf) -> inf
               esac;
               
  fun insertRec (current) {
    case current of
      (head@[currAssty, ops]) : tail ->       
        case find (fun ([x, _]) {compare (x, anchor) == 0}, ops) of
          None     -> head : insertRec (tail)
        | Some (_) ->
            case pos of
              Before (_) -> [assty, {[inf, Custom (name)]}] : current
            | After  (_) -> head : [assty, {[inf, Custom (name)]}] : tail
            | At     (_) ->
               if compare (assty, currAssty) != 0
               then error (sprintf ("the associativity for ""%s"" has to coincide with that for ""%s""", inf, anchor), loc)
               else [currAssty, [inf, Custom (name)] : ops] : tail
               fi
            esac
        esac
    | {} -> error (sprintf ("no infix operator ""%s"" is found in the scope", anchor), loc)
    esac
  }

  insertRec (infixes)
}



